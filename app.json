{
  "expo": {
    "name": "Sạc Xe Đê",
    "slug": "Sac-Xe-De",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-sac-xe-de-tu-anh.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-sac-xe-de-tu-anh.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.ai.slink.enovo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ứng dụng sử dụng vị trí của bạn để hiển thị các thiết bị sạc gần đó và hỗ trợ chức năng bản đồ.",
        "NSCameraUsageDescription": "Ứng dụng sử dụng camera để quét mã QR khi tương tác với trụ sạc và cung cấp thông tin phản ảnh sự cố sạc.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh để bạn chọn và tải lên hình ảnh giấy phép lái xe khi thêm xe vào hệ thống.",
        "NSUserNotificationUsageDescription": "Ứng dụng gửi thông báo về trạng thái thanh toán, thông báo trạng thái sạc xe và cảnh báo tài khoản.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-sac-xe-de-tu-anh.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "vn.ai.slink.enovo",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/logo_white_background_500.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-sac-xe-de-tu-anh.png"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/logo-sac-xe-de-tu-anh.png",
      "color": "#ffffff"
    },
    "extra": {
      "eas": {
        "projectId": "549591e2-d911-4403-bed9-2975feda19b9"
      },
      "apiUrl": "http://192.168.1.13:6868",
      "googleMapsApiKey": "AIzaSyCe5Ft06NdRvyQKi3opWZmJYMr5LxHndb8",
      "isAndroidMapEnabled": true,
      "apiGoogleMapUrl": "https://www.google.com/maps/dir/?api=1&destination={lat},{lng}",
      "apiAppleMapUrl": "http://maps.apple.com/?daddr={lat},{lng}&dirflg=d"
    },
    "owner": "manhtung"
  }
